{
  "name": "endercord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && npm run register",
    "register": "node register-commands.mjs",
    "register:force": "node register-commands.mjs --force",
    "build:node": "node build-node.mjs",
    "start": "node dist/server.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node build-node.mjs --test && node --test dist/server.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "sharp@0.35.5": true
  }
}
