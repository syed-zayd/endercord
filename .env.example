BOT_DOMAIN=endercord.example.com
DISCORD_APP_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key
BOT_TOKEN=your_bot_token
# Default: Minecraft runs on the same Linux machine as Docker.
# For a different Minecraft host, replace with its IP or hostname, reachable from Docker.
PLUGIN_HOST=host.docker.internal
PLUGIN_PORT=8080
